{
  "name": "stayzio-root",
  "version": "1.0.0",
  "private": true,
  "description": "Stayzio - Full-Featured Hotel Discovery & Booking Platform",
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm run install:server && npm run install:client",
    "seed": "npm --prefix server run seed",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "test:api": "npm --prefix server run test:api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
